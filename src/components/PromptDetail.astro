---
import { catalog, localPath, sitePath, jsonForScript } from '../lib/site.ts';
import { renderPrompt } from '../lib/catalog.ts';
import type { Prompt } from '../lib/schema.ts';
interface Props { prompt: Prompt; }
const { prompt } = Astro.props;
const example = prompt.examples[0]!;
const hasVariables = Object.keys(prompt.variables).length > 0;
const initial = renderPrompt(catalog, { id: prompt.id, expected_revision: prompt.prompt_revision, variables: {} });
const label = (id: string) => [...catalog.taxonomy.use_cases, ...catalog.taxonomy.styles, ...catalog.taxonomy.models].find(term => term.id === id)?.label ?? id;
const statuses = { verified: '已验证', declared: '作者声明', unknown: '未知', incompatible: '明确不兼容' };
const parameterNames: Record<string, string> = { transparent_background: '透明背景', seed: '种子', sampler: '采样器', steps: '步数', cfg_scale: '引导强度', width: '生成宽度', height: '生成高度', size: '尺寸', aspect_ratio: '画幅比', quality: '质量' };
const parameterValue = (value: string | number | boolean | null) => value === null ? '未知' : typeof value === 'boolean' ? value ? '是' : '否' : String(value);
const readableParameters = Object.entries(example.parameters).map(([key, value]) => `${parameterNames[key] ?? key}：${parameterValue(value)}`).join('；');
---
<div class="page-shell detail-shell" data-prompt-revision={prompt.prompt_revision}>
  <a class="back-link" href={sitePath('#gallery')}>← 画廊</a>
  <header class="detail-heading"><h1>{prompt.title}</h1><div class="tag-row">{[...prompt.use_cases, ...prompt.styles].map(id => <span class="badge badge-soft">{label(id)}</span>)}</div></header>
  <div class="detail-workspace">
    <div class="detail-preview-column">
      <figure class="detail-art"><a href={localPath(example.image)} target="_blank" rel="noreferrer" aria-label="在新窗口查看原图"><img src={localPath(example.image)} width={example.width} height={example.height} alt={example.alt} loading="lazy" decoding="async" /></a></figure>
      {prompt.examples.length > 1 && <details class="card more-examples" id="more-examples"><summary>更多配图（{prompt.examples.length - 1}）</summary>{prompt.examples.slice(1).map(item => <figure class="additional-example"><a href={localPath(item.image)} target="_blank" rel="noreferrer"><img data-src={localPath(item.image)} width={item.width} height={item.height} alt={item.alt} loading="lazy" /></a><figcaption>{item.created_at ?? '生成日期未提供'} · {item.generator} · {item.model ?? '底层模型未知'}</figcaption><p>{item.provenance}</p><label>实际生成提示词<textarea class="textarea prompt-text" readonly rows="5">{item.effective_prompt}</textarea></label></figure>)}</details>}
      <details class="card source-card">
        <summary>来源与生成信息</summary>
        <p>{prompt.source.author}</p><p>{prompt.source.origin}</p>
        <p>提示词许可：{prompt.source.text_license}</p><p>图片许可：{prompt.source.image_license}</p>
        <dl class="generation-facts"><div><dt>生成日期</dt><dd>{example.created_at ?? '生成日期未提供'}</dd></div><div><dt>生成工具</dt><dd>{example.generator}</dd></div><div><dt>底层模型 / 版本</dt><dd>{example.model ?? '未知 · 工具未提供'}</dd></div><div><dt>尺寸</dt><dd>{example.width} × {example.height} 像素</dd></div><div><dt>已知参数</dt><dd>{readableParameters || '未提供'}</dd></div></dl>
        {prompt.model_compatibility.length ? <ul class="compatibility-list">{prompt.model_compatibility.map(item => <li><strong>{label(item.model)} · {statuses[item.status]}</strong><p>{item.note}</p></li>)}</ul> : <p>模型兼容性未验证。</p>}
        <ul class="condition-list">{prompt.conditions.map(condition => <li>{condition}</li>)}</ul>
        <details><summary>完整生成记录</summary><p>{example.provenance}</p><p>生成时模板版本：{example.template_version}</p>{example.effective_prompt !== prompt.template && <><label class="label" for="effective-prompt">实际使用的提示词</label><textarea class="textarea prompt-text source-prompt" id="effective-prompt" readonly rows="8">{example.effective_prompt}</textarea></>}{Object.keys(example.variables).length > 0 && <p>实际变量：{JSON.stringify(example.variables)}</p>}{Object.keys(example.parameters).length > 0 && <p>原始参数：{JSON.stringify(example.parameters)}</p>}</details>
      </details>
    </div>
    <div class="detail-editor-column">
      {hasVariables && <section class="card editor-card" aria-labelledby="editor-title">
        <div class="panel-heading"><h2 id="editor-title">填写变量</h2></div><p class="panel-description">{prompt.summary}</p>
        <form id="variables-form" novalidate>
          {Object.entries(prompt.variables).map(([name, variable]) => <div class="variable-field">
            <label class="label" for={`variable-${name}`}>{variable.label}{variable.required && <span class="required-label">必填</span>}</label>
            {variable.options ? <select class="select" id={`variable-${name}`} name={name} required={variable.required} aria-describedby={`help-${name} error-${name}`} data-variable={name}>
              {(!variable.required || variable.default === undefined) && <option value="">{variable.required ? '请选择' : '不填写'}</option>}
              {variable.options.map(value => <option value={value} selected={value === variable.default}>{value}</option>)}
            </select> : <textarea class="textarea" id={`variable-${name}`} name={name} rows="3" required={variable.required} aria-describedby={`help-${name} error-${name}`} data-variable={name}>{variable.default ?? ''}</textarea>}
            <p class="field-help" id={`help-${name}`}>{variable.description}（最多 {variable.max_length} 个字符）</p><p class="field-error" id={`error-${name}`} hidden></p>
          </div>)}
          <button class="btn btn-ghost btn-sm reset-variables" type="reset">恢复默认</button>
        </form>
        <div class="render-heading"><h3>提示词</h3></div><p class="alert validation-error" id="render-error" role="alert" hidden></p><label class="sr-only" for="rendered-prompt">填写后的正向提示词</label><textarea class="textarea prompt-text" id="rendered-prompt" readonly rows="9">{initial.ok ? initial.data.prompt : ''}</textarea><div class="copy-row"><button class="btn btn-primary" id="copy-rendered" type="button" disabled={!initial.ok}>复制</button><span class="copy-status" id="render-copy-status" role="status" aria-live="polite"></span></div>
        {prompt.negative_template && <div class="negative-section"><div class="render-heading"><h3>负面提示词</h3></div><label class="sr-only" for="rendered-negative">填写后的负面提示词</label><textarea class="textarea prompt-text" id="rendered-negative" readonly rows="4">{initial.ok ? initial.data.negative_prompt : ''}</textarea><div class="copy-row"><button class="btn btn-outline" id="copy-rendered-negative" type="button" disabled={!initial.ok}>复制负面提示词</button><span class="copy-status" id="negative-copy-status" role="status" aria-live="polite"></span></div></div>}
      </section>}
      <section class="card original-card" aria-labelledby="original-title"><div class="panel-heading"><h2 id="original-title">{hasVariables ? '模板原文' : '提示词'}</h2></div>{!hasVariables && <p class="panel-description">{prompt.summary}</p>}<label class="sr-only" for="original-prompt">提示词原文</label><textarea class="textarea prompt-text" id="original-prompt" readonly rows={hasVariables ? 7 : 14}>{prompt.template}</textarea><div class="copy-row"><button class:list={['btn', hasVariables ? 'btn-outline' : 'btn-primary']} id="copy-original" type="button">{hasVariables ? '复制原文' : '复制'}</button><span class="copy-status" id="original-copy-status" role="status" aria-live="polite"></span></div>{prompt.negative_template && <div class="negative-section"><label class="label" for="original-negative">负面原文</label><textarea class="textarea prompt-text" id="original-negative" readonly rows="4">{prompt.negative_template}</textarea><div class="copy-row"><button class="btn btn-outline" id="copy-original-negative" type="button">复制负面原文</button><span class="copy-status" id="original-negative-copy-status" role="status" aria-live="polite"></span></div></div>}<noscript><p class="alert">启用 JavaScript 使用复制按钮，或直接选择原文复制。</p></noscript></section>
      {prompt.related_ids.length > 0 && <section class="card related-card"><h2>相关提示词</h2><ul>{prompt.related_ids.map(id => { const related = catalog.prompts.find(item => item.id === id)!; return <li><a href={localPath(related.url)}>{related.title}</a></li>; })}</ul></section>}
    </div>
  </div>
</div>
<script id="detail-data" type="application/json" is:inline set:html={jsonForScript({ catalog: { ...catalog, prompts: [prompt], archives: [] }, id: prompt.id })} />
<script>import '../scripts/prompt-detail.ts';</script>
