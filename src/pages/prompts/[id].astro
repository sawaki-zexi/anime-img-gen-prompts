---
import Layout from '../../layouts/Layout.astro';
import { catalog, localPath, sitePath, jsonForScript } from '../../lib/site.ts';
import { renderPrompt } from '../../lib/catalog.ts';
import type { Prompt } from '../../lib/schema.ts';
export function getStaticPaths() { return catalog.prompts.map(prompt => ({ params: { id: prompt.id }, props: { prompt } })); }
interface Props { prompt: Prompt; }
const { prompt } = Astro.props;
const example = prompt.examples[0]!;
const initial = renderPrompt(catalog, { id: prompt.id, expected_revision: prompt.prompt_revision, variables: {} });
const initialText = initial.ok ? initial.data.prompt : '';
const label = (id: string) => [...catalog.taxonomy.use_cases, ...catalog.taxonomy.styles].find(term => term.id === id)?.label ?? id;
---
<Layout title={`${prompt.title} · 动漫灵感工坊`} description={prompt.summary}>
  <div class="page-shell detail-shell" data-prompt-revision={prompt.prompt_revision}>
    <a class="back-link" href={sitePath('#gallery')}>← 回到灵感画廊</a>
    <header class="detail-heading"><div><span class="eyebrow">PROMPT / 001</span><h1>{prompt.title}<span aria-hidden="true"> ✦</span></h1><p>{prompt.summary}</p></div><div class="tag-row">{[...prompt.use_cases, ...prompt.styles].map(id => <span class="badge badge-soft">{label(id)}</span>)}</div></header>
    <figure class="detail-art"><a href={localPath(example.image)} target="_blank" rel="noreferrer" aria-label="在新窗口查看完整示例图"><img src={localPath(example.image)} width={example.width} height={example.height} alt={example.alt} fetchpriority="high" /></a><figcaption><span>✧ 实际生成示例 · {example.created_at}</span><a href={localPath(example.image)} target="_blank" rel="noreferrer">查看原尺寸 ↗</a></figcaption></figure>
    <div class="detail-columns">
      <section class="card editor-card" aria-labelledby="editor-title">
        <div class="panel-heading"><div><span class="eyebrow">MAKE IT YOURS</span><h2 id="editor-title">换成你的主角</h2></div><span class="badge language-label">英文提示词</span></div>
        <p class="panel-description">保留晴空与海岸，让画面有自己的故事。</p>
        <form id="variables-form" novalidate>
          {Object.entries(prompt.variables).map(([name, variable]) => <div class="variable-field"><label class="label" for={`variable-${name}`}>{variable.label}{variable.required && <span class="required-label">必填</span>}</label><textarea class="textarea" id={`variable-${name}`} name={name} rows="4" required={variable.required} aria-describedby={`help-${name}`} data-variable={name}>{variable.default ?? ''}</textarea><p class="field-help" id={`help-${name}`}>{variable.description}</p></div>)}
          <button class="btn btn-ghost btn-sm reset-variables" type="reset">恢复示例主体 ↺</button>
        </form>
        <div class="render-heading"><h3>填写后的提示词</h3><span class="preview-label">实时预览</span></div>
        <p class="alert validation-error" id="render-error" role="alert" hidden></p>
        <label class="sr-only" for="rendered-prompt">填写后的正向提示词</label><textarea class="textarea prompt-text" id="rendered-prompt" readonly rows="11">{initialText}</textarea>
        <div class="copy-row"><button class="btn btn-primary" id="copy-rendered" type="button" disabled={!initial.ok}>复制填写后的提示词 <span aria-hidden="true">↗</span></button><span class="copy-status" id="render-copy-status" role="status" aria-live="polite"></span></div>
        <noscript><p class="alert">启用 JavaScript 后可填写变量与使用复制按钮；也可直接选择上方默认文本复制。</p></noscript>
      </section>
      <aside class="detail-aside">
        <section class="card info-card" aria-labelledby="conditions-title"><span class="eyebrow">BEFORE YOU CREATE</span><h2 id="conditions-title">这张图是怎么来的</h2><dl class="generation-facts"><div><dt>生成工具</dt><dd>{example.generator}</dd></div><div><dt>底层模型 / 版本</dt><dd>{example.model ?? '未知 · 工具未提供'}</dd></div><div><dt>画幅</dt><dd>{example.width} × {example.height} · 3:1</dd></div><div><dt>生成参数</dt><dd>{Object.keys(example.parameters).length ? JSON.stringify(example.parameters) : '种子与其他参数未知'}</dd></div><div><dt>模型兼容性</dt><dd>尚未验证具体模型</dd></div></dl><ul class="condition-list">{prompt.conditions.map(condition => <li>{condition}</li>)}</ul></section>
        <section class="card source-card" aria-labelledby="source-title"><span class="eyebrow">CREDIT & ORIGIN</span><h2 id="source-title">来源与使用说明</h2><p>{prompt.source.author}</p><p>{prompt.source.origin}</p><p class="source-note">{prompt.source.text_license}</p><p class="source-note">{prompt.source.image_license}</p><details><summary>查看完整生成记录</summary><p>{example.provenance}</p><p>生成时模板版本：{example.template_version}</p><label class="label" for="effective-prompt">示例实际使用的完整提示词</label><textarea class="textarea prompt-text source-prompt" id="effective-prompt" readonly rows="8">{example.effective_prompt}</textarea></details></section>
      </aside>
    </div>
    <section class="card original-card" aria-labelledby="original-title"><div class="panel-heading"><div><span class="eyebrow">THE ORIGINAL TEMPLATE</span><h2 id="original-title">提示词原文</h2></div><span class="badge badge-soft">保留 {'{subject}'} 占位符</span></div><p class="panel-description">直接复制模板，自行修改；上面的填写区会帮你完成变量替换。</p><label class="sr-only" for="original-prompt">原始正向提示词模板</label><textarea class="textarea prompt-text" id="original-prompt" readonly rows="7">{prompt.template}</textarea><div class="copy-row"><button class="btn btn-outline" id="copy-original" type="button">复制原文</button><span class="copy-status" id="original-copy-status" role="status" aria-live="polite"></span></div></section>
    <p class="revision-note">模板版本 {prompt.template_version} · 更新于 {prompt.updated_at}<br /><span>条目修订 <code>{prompt.prompt_revision}</code></span></p>
  </div>
  <script id="detail-data" type="application/json" is:inline set:html={jsonForScript({ catalog: { ...catalog, prompts: [prompt] }, id: prompt.id })} />
  <script>
    import '../../scripts/prompt-detail.ts';
  </script>
</Layout>
