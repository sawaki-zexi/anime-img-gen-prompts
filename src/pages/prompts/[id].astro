---
import Layout from '../../layouts/Layout.astro';
import PromptDetail from '../../components/PromptDetail.astro';
import { catalog, localPath, sitePath } from '../../lib/site.ts';
import type { Catalog, Prompt } from '../../lib/schema.ts';
export function getStaticPaths() {
  return [...catalog.prompts.map(prompt => ({ params: { id: prompt.id }, props: { prompt } })), ...catalog.archives.map(archive => ({ params: { id: archive.id }, props: { archive } }))];
}
interface Props { prompt?: Prompt; archive?: Catalog['archives'][number]; }
const { prompt, archive } = Astro.props;
const title = prompt?.title ?? archive!.title;
---
<Layout title={`${title} · 动漫灵感工坊`} description={prompt?.summary ?? '此提示词已归档，请查看当前可用的替代条目。'}>
  {prompt ? <PromptDetail prompt={prompt} /> : <div class="page-shell detail-shell archive-shell"><a class="back-link" href={sitePath('#gallery')}>← 回到灵感画廊</a><section class="card archived-card" aria-labelledby="archive-title"><span class="badge badge-soft">已归档</span><h1 id="archive-title">{archive!.title}</h1><p>{archive!.archive_note ?? '此条目已从当前内容库归档，模板正文不再公开提供。'}</p><p>归档更新：{archive!.updated_at}</p><h2>可以继续探索</h2>{archive!.related_ids.length ? <ul>{archive!.related_ids.map(id => { const related = catalog.prompts.find(item => item.id === id)!; return <li><a href={localPath(related.url)}>{related.title} →</a></li>; })}</ul> : <p>暂未指定替代条目。你可以回到画廊查找其他创作方向。</p>}<a class="btn btn-primary" href={sitePath('#gallery')}>浏览当前模板</a></section></div>}
</Layout>
