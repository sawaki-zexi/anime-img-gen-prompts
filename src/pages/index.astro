---
import Layout from '../layouts/Layout.astro';
import PromptCard from '../components/PromptCard.astro';
import { catalog, searchCatalog, localPath, jsonForScript } from '../lib/site.ts';
import { searchPrompts } from '../lib/catalog.ts';
const result = searchPrompts(searchCatalog, {});
if (!result.ok) throw new Error(result.error.message);
const featured = catalog.prompts[0];
const hero = featured?.examples[0];
const templateItem = result.data.items[0];
const hasPublished = catalog.prompts.length > 0;
---
<Layout>
  <section class:list={['gallery-hero', { 'gallery-hero-empty': !hero }]} aria-labelledby="hero-title">
    {hero && <img class="hero-art" src={localPath(hero.image)} width={hero.width} height={hero.height} alt="" fetchpriority="high" />}
    <div class="hero-shade"></div>
    <div class="hero-inner"><h1 id="hero-title">动漫提示词</h1></div>
  </section>
  <div class="page-shell gallery-shell">
    <form id="search-form" role="search" novalidate>
      <div class="search-surface"><span class="search-icon" aria-hidden="true">⌕</span><label class="sr-only" for="prompt-query">搜索提示词</label><input class="input search-input" id="prompt-query" name="q" type="search" placeholder="搜索提示词…" maxlength="512" autocomplete="off" /><button class="btn btn-primary" type="submit">搜索</button></div>
      <div class="filter-surface">
        <fieldset class="filter-group"><legend>用途</legend><div class="filter-chips">{catalog.taxonomy.use_cases.map(term => <label class="filter-chip"><input class="checkbox checkbox-xs" type="checkbox" name="use_case" value={term.id} /><span>{term.label}</span></label>)}</div></fieldset>
        <fieldset class="filter-group"><legend>画风</legend><div class="filter-chips">{catalog.taxonomy.styles.map(term => <label class="filter-chip"><input class="checkbox checkbox-xs" type="checkbox" name="style" value={term.id} /><span>{term.label}</span></label>)}</div></fieldset>
        <div class="filter-options"><details class="advanced-filters" id="advanced-filters"><summary>更多筛选</summary><div class="filter-tools"><label class="model-filter" for="model-filter">适用模型<input class="input input-sm" id="model-filter" name="model" type="text" list="model-options" placeholder="全部模型" maxlength="200" /><datalist id="model-options">{catalog.taxonomy.models.map(term => <option value={term.id}>{term.label}</option>)}</datalist></label><label class="verified-filter"><input class="checkbox checkbox-sm" type="checkbox" name="verified" value="1" />仅此模型已验证</label><label class="page-size" for="page-size">每页<select class="select select-sm" id="page-size" name="limit"><option value="5">5 条</option><option value="10">10 条</option><option value="20">20 条</option></select></label></div></details><button class="btn btn-ghost btn-sm" id="clear-search" type="button" hidden>清除筛选</button></div>
      </div>
    </form>
    <section id="gallery" class="gallery-section" aria-labelledby="gallery-title">
      <div class="section-heading"><h2 class="sr-only" id="gallery-title" tabindex="-1">画廊</h2><span class="badge count-badge" id="result-count" aria-live="polite">{result.data.items.length} 条</span></div>
      <p class="applied-filters" id="applied-filters" aria-live="polite" hidden></p>
      <p class="search-error" id="search-error" role="alert" hidden></p>
      <div id="prompt-grid" class="prompt-grid">{result.data.items.map(item => <PromptCard item={item} />)}</div>
      <div class="card empty-state" id="empty-state" hidden={result.data.items.length > 0}><h3>{hasPublished ? '没有匹配的提示词' : '暂无提示词'}</h3><p>{hasPublished ? '换个关键词或减少筛选。' : '目前没有已发布的模板。'}</p><button class="btn btn-primary btn-sm" id="empty-reset" type="button" hidden>清除筛选</button></div>
      <div class="pagination" aria-label="画廊分页" hidden={!result.data.next_cursor}><button class="btn btn-outline btn-sm" id="first-page" type="button" hidden>回到第一页</button><button class="btn btn-primary" id="next-page" type="button" hidden={!result.data.next_cursor}>下一页</button></div>
      <noscript><p class="alert">启用 JavaScript 后可筛选、翻页与直接复制。你也可以打开上方任一详情，选择模板文本复制。</p></noscript>
    </section>
  </div>
  <template id="prompt-card-template">{templateItem && <PromptCard item={templateItem} />}</template>
  <script id="catalog-data" type="application/json" is:inline set:html={jsonForScript(searchCatalog)} />
  <script>import '../scripts/gallery.ts';</script>
</Layout>
