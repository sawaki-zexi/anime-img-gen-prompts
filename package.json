{
  "name": "anime-img-gen-prompts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "lockfile:check": "node scripts/check-lockfile.ts",
    "content:build": "tsx scripts/build-catalog.ts",
    "dev": "npm run content:build && astro dev --host 127.0.0.1",
    "dev:mcp": "npm run content:build && tsx src/server/start.ts",
    "build": "npm run content:build && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "start:mcp": "tsx src/server/start.ts",
    "typecheck": "npm run content:build && astro check && tsc --noEmit",
    "test": "npm run content:build && tsx --test tests/*.test.ts",
    "test:site": "npm run build && tsx --test tests/site.integration.ts",
    "check": "npm run lockfile:check && npm run typecheck && npm test && npm run test:site"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "gray-matter": "4.0.3",
    "motion": "14.11.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@modelcontextprotocol/client": "2.4.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "astro": "7.4.7",
    "daisyui": "5.7.50",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
