# Defaults are shown here. These values are read at content-build time.
SITE_URL=http://localhost:5173
SITE_BASE_PATH=/
# Local defaults; the process does not automatically load this file.
MCP_PORT=3333
MCP_MODE=local
MCP_BIND_HOST=127.0.0.1
MCP_PATH=/mcp
MCP_MAX_BODY_BYTES=131072
MCP_RATE_LIMIT=120
MCP_GLOBAL_RATE_LIMIT=2400
MCP_RATE_WINDOW_MS=60000
MCP_MAX_CLIENTS=4096
# Independent production Node hosting requires explicit configuration:
# MCP_MODE=production
# PUBLIC_ORIGIN=https://anime-prompt-atelier.memorablestone1.chatgpt.site
# MCP_PATH=/api/mcp
# MCP_CATALOG_FILE=<immutable-release-directory>/snapshot/catalog.json
# MCP_BIND_HOST=0.0.0.0
